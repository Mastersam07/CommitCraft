{
  "name": "commitcraft",
  "displayName": "CommitCraft",
  "description": "AI-powered commit messages that actually explain what you did",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mastersam07/commitcraft"
  },
  "license": "MIT",
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages",
    "AI"
  ],
  "keywords": [
    "Git",
    "Commit",
    "AI",
    "Gemini",
    "Message",
    "Machine Learning",
    "Programming Languages",
    "AI Assistant",
    "AutoCommit",
    "LLM"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitcraft.generateMessage",
        "title": "Generate Commit Message",
        "category": "CommitCraft"
      },
      {
        "command": "commitcraft.generateWithExplanation",
        "title": "Generate Commit Message with Explanation",
        "category": "CommitCraft"
      }
    ],
    "keybindings": [
      {
        "command": "commitcraft.generateMessage",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "scmProvider == git"
      }
    ],
    "configuration": {
      "title": "CommitCraft",
      "properties": {
        "commitcraft.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Your Gemini API key",
          "order": 0
        },
        "commitcraft.model": {
          "type": "string",
          "enum": [
            "gemini-1.5-flash",
            "gemini-1.5-pro"
          ],
          "enumDescriptions": [
            "Faster model, perfect for most commits",
            "More powerful model for complex changes"
          ],
          "default": "gemini-1.5-flash",
          "description": "Which Gemini model to use",
          "order": 1
        },
        "commitcraft.conventionalCommits": {
          "type": "boolean",
          "default": true,
          "description": "Use conventional commit format (feat:, fix:, etc.)",
          "order": 2
        },
        "commitcraft.includeEmoji": {
          "type": "boolean",
          "default": false,
          "description": "Include emoji in commit messages (✨, 🐛, etc.)",
          "order": 3
        },
        "commitcraft.messageStyle": {
          "type": "string",
          "enum": [
            "brief",
            "standard",
            "detailed"
          ],
          "enumItemLabels": [
            "Brief",
            "Standard",
            "Detailed"
          ],
          "default": "standard",
          "description": "Default message style",
          "order": 4
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "simple-git": "^3.30.0"
  }
}